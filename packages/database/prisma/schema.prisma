// Vynce — CRM imobiliário
// Modelo de dados do módulo de Cadastros (Imobiliárias / Houses e seus usuários).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Diferencia uma imobiliária tradicional de uma "house"
/// (estrutura de vendas interna de uma incorporadora/construtora).
enum EntityType {
  IMOBILIARIA
  HOUSE
}

/// Perfis de acesso. O gerente é criado automaticamente conforme o tipo da entidade.
enum UserRole {
  SUPER_ADMIN
  GERENTE_IMOBILIARIA
  GERENTE_HOUSE
  CORRETOR
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Imobiliária ou House cadastrada na plataforma.
model Agency {
  id String @id @default(cuid())

  type EntityType @default(IMOBILIARIA)

  // Identificação
  tradeName         String // Nome Fantasia
  legalName         String // Razão Social
  cnpj              String       @unique // somente dígitos
  stateRegistration String? // Inscrição Estadual (opcional)
  creciJuridico     String // CRECI Jurídico

  // Contato
  phone   String // Telefone comercial (somente dígitos)
  email   String // E-mail comercial
  website String?

  // Endereço
  zipCode    String // CEP (somente dígitos)
  street     String // Logradouro
  number     String
  complement String?
  district   String // Bairro
  city       String
  state      String // UF (2 letras)

  // Informações adicionais
  logoUrl     String?
  description String? @db.Text

  status AgencyStatus @default(ACTIVE)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([tradeName])
  @@map("agencies")
}

/// Usuário da plataforma. O gerente/responsável da imobiliária tem isManager = true.
model User {
  id String @id @default(cuid())

  fullName     String // Nome completo
  cpf          String     @unique // somente dígitos
  creci        String // CRECI individual
  email        String     @unique // login
  phone        String
  passwordHash String
  role         UserRole   @default(CORRETOR)
  status       UserStatus @default(ACTIVE)
  isManager    Boolean    @default(false)

  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@map("users")
}
