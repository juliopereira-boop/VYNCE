# PostgreSQL — usado pelo Prisma (packages/database).
#
# DATABASE_URL: conexão usada em runtime. Em produção serverless (Vercel),
#   use a string COM POOLING do seu provedor (Supabase Supavisor porta 6543,
#   acrescentando ?pgbouncer=true&connection_limit=1).
# DIRECT_URL: conexão DIRETA, usada apenas por migrations (prisma migrate).
#   No Supabase é a string da porta 5432. Em dev local, aponta para o mesmo banco.
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://vynce:vynce_dev_pwd@127.0.0.1:5432/vynce?schema=public"
DIRECT_URL="postgresql://vynce:vynce_dev_pwd@127.0.0.1:5432/vynce?schema=public"

# Node environment
NODE_ENV="development"
